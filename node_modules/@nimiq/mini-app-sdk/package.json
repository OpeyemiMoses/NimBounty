{
  "name": "@nimiq/mini-app-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "SDK for building Nimiq Mini Apps",
  "license": "MIT",
  "author": "The Nimiq Development Team <info@nimiq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimiq/trust-web3-provider/tree/nimiq",
    "directory": "packages/mini-app-sdk"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./provider": {
      "import": {
        "types": "./dist/provider.d.ts",
        "default": "./dist/provider.js"
      },
      "require": {
        "types": "./dist/provider.d.cts",
        "default": "./dist/provider.cjs"
      }
    }
  },
  "sideEffects": [
    "globals.ts"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build:clean": "rm -rf dist .build",
    "build:source": "bun run build:clean && tsup"
  },
  "devDependencies": {
    "@nimiq/web3-provider-nimiq": "workspace:*",
    "tsup": "^8.5.1"
  }
}
